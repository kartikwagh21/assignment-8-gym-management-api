      "item": [
        {
          "name": "Renew Membership (Extend 6 Months + Upgrade Tier)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalMonths\": 6,\n  \"tier\": \"Platinum\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/{{memberId}}/renew",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "{{memberId}}", "renew"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Membership tier is Platinum', function () {",
                  "    pm.expect(json.user.membershipTier).to.eql('Platinum');",
                  "    pm.expect(json.user.membershipStatus).to.eql('active');",
                  "});"
